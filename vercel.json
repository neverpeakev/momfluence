{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/optimizer/simulate/route.ts": { "memory": 2048, "maxDuration": 60 },
    "app/api/optimizer/tick/route.ts": { "memory": 2048, "maxDuration": 60 },
    "app/api/optimizer/launch/route.ts": { "memory": 1024, "maxDuration": 300 },
    "app/api/render/creative/[slug]/route.ts": { "memory": 2048, "maxDuration": 60 },
    "app/api/render/post/[slug]/route.ts": { "memory": 2048, "maxDuration": 60 },
    "app/api/render/logo/[variant]/route.ts": { "memory": 2048, "maxDuration": 60 },
    "app/api/social/fb-daily-generate/route.ts": { "memory": 1024, "maxDuration": 120 },
    "app/api/social/ig-mirror/route.ts": { "memory": 1024, "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/optimizer/tick",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/social/fb-daily-generate",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/social/ig-mirror",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/cron/inbox-agent",
      "schedule": "*/30 * * * *"
    }
  ]
}
