# Stripe checkout. SECRET_KEY powers all server-side Stripe calls.
# PUBLISHABLE_KEY (pk_live_… / pk_test_…) is required ONLY for the embedded
# checkout page at /checkout (Stripe Embedded Checkout mounts client-side with
# it). The hosted flow on the homepage/​signup buttons does NOT need it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PRICE_ID_MEMBERSHIP=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
APPS_SCRIPT_LEAD_URL=https://script.google.com/macros/s/AKfycbwbRJ7wCahXVBuiL1AF2rh1gWyTl9TB-eC61VZCP1bmognjw6yWm7tbUGizxFVKAUgcIg/exec
DEFAULT_NETWORK_ADAPTER=mock
EVERFLOW_API_KEY=
EVERFLOW_AFFILIATE_ID=
SCALEO_API_KEY=
SCALEO_AFFILIATE_ID=
POSTBACK_SECRET=replace-me-with-32-byte-secret

# ─── Email infra (Resend outbound + ImprovMX inbound forwarding) ───────────
# Setup checklist: docs/planning/email-infra.md
# Until these are set, lib/email.ts.sendEmail() no-ops with a warn log.
RESEND_API_KEY=
EMAIL_FROM=MomFluence <hello@momfluence.app>
EMAIL_REPLY_TO=hello@momfluence.app

# ─── Inbox agent cron — Gmail API OAuth refresh-token for hello@... reader ─
# /api/cron/inbox-agent uses these to poll Kevin's Gmail every 30 min for
# new inbound threads at hello@momfluence.app, auto-ack via Resend, label.
# Until all three are set, the cron returns no_op_pending_env.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: lets an admin force a tick via curl -H "x-admin-key: ..."
INBOX_AGENT_ADMIN_KEY=
